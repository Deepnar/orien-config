# Clean launch directly into Zsh
command = /usr/bin/zsh

# Layout & Typography
font-family = "JetBrainsMono Nerd Font"
font-size = 12
background-opacity = 0.8
background-blur-radius = 0

# Invisible 25px cushion so text doesn't hit the screen edges
window-padding-x = 25
window-padding-y = 25
window-decoration = false
theme = catppuccin-mocha

# --- NATIVE GHOSTTY PANE SPLITS ---

# 1. Create Splits
keybind = ctrl+shift+r=new_split:right
keybind = ctrl+shift+d=new_split:down

# 2. Navigate Panes (Using your Vim Home-Row Motions!)
keybind = alt+h=goto_split:left
keybind = alt+l=goto_split:right
keybind = alt+k=goto_split:up
keybind = alt+j=goto_split:down

# 3. Control Panes
keybind = ctrl+shift+z=toggle_split_zoom
keybind = ctrl+shift+w=close_surface

