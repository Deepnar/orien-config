# ============================================================
# 1. ZSH CORE — HISTORY & COMPLETION
# ============================================================

HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000

setopt APPEND_HISTORY
setopt SHARE_HISTORY

autoload -Uz compinit
compinit


# ============================================================
# 2. CAELESTIA COLORS + PROMPT
# ============================================================

# Load Caelestia's current terminal color sequence
\cat "$HOME/.local/state/caelestia/sequences.txt" 2>/dev/null

# Start each new shell cleanly
clear

# System info — disabled for now
# fastfetch

# Starship prompt
eval "$(starship init zsh)"


# ============================================================
# 3. SHELL TOOLS
# ============================================================

# Zoxide replaces cd
eval "$(zoxide init zsh --cmd cd)"

# fzf integration
source /usr/share/fzf/key-bindings.zsh 2>/dev/null
source /usr/share/fzf/completion.zsh 2>/dev/null


# ============================================================
# 4. ALIASES
# ============================================================

alias e='exit'

alias ls='eza --icons --git'
alias ll='eza -la --icons --git'

alias cat='bat'
alias grep='rg'
alias lf='yazi'
alias c='clear'

# ICE
alias i='cd "$HOME/Programs/ice" && source .venv/bin/activate && clear'

# Docker
alias dup='cd docker && docker compose up -d && cd ..'
alias ddown='cd docker && docker compose down && cd ..'

# tmux
alias t='tmux new-session -A -s main'
alias tn='tmux new-session'


# ============================================================
# 5. FUNCTIONS
# ============================================================

# Launch Neovim in its own low-padding Ghostty window
nvim() {
    setsid -f ghostty \
        --window-padding-x=6 \
        --window-padding-y=6 \
        --background=#0e0e0e \
        --window-padding-color=background \
        -e nvim "$@" \
        </dev/null >/dev/null 2>&1
}


# Yazi wrapper:
# exiting Yazi changes the current shell to Yazi's last directory
y() {
    local tmp
    tmp="$(mktemp -t "yazi-cwd.XXXXX")"

    yazi "$@" --cwd-file="$tmp"

    local cwd
    cwd="$(command cat -- "$tmp")"

    if [[ -n "$cwd" && "$cwd" != "$PWD" ]]; then
        builtin cd -- "$cwd"
    fi

    rm -f -- "$tmp"
}


# Launch VS Code without filling the terminal with logs
code() {
    command code "$@" >/dev/null 2>&1 &
}


# ============================================================
# 6. ZSH PLUGINS
# ============================================================

source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh 2>/dev/null
source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh 2>/dev/null
source /usr/share/zsh/plugins/zsh-history-substring-search/zsh-history-substring-search.zsh 2>/dev/null


# ============================================================
# 7. ENVIRONMENT
# ============================================================

# Optional local environment file
[[ -f "$HOME/.local/bin/env" ]] && . "$HOME/.local/bin/env"


# User binaries
export PATH="$HOME/.local/bin:$PATH"


# CUDA
export PATH="/opt/cuda/bin:$PATH"
export LD_LIBRARY_PATH="/opt/cuda/lib64${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"


# Node / fnm
eval "$(fnm env --use-on-cd)"


# SDKMAN
export SDKMAN_DIR="$HOME/.sdkman"

if [[ -s "$SDKMAN_DIR/bin/sdkman-init.sh" ]]; then
    source "$SDKMAN_DIR/bin/sdkman-init.sh"
fi


# OpenCode
export PATH="$HOME/.opencode/bin:$PATH"


# Locale
export LANG=en_IN.UTF-8
export LC_CTYPE=en_IN.UTF-8
