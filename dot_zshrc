# --- 1. CORE ZSH (History & Completion) ---
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt APPEND_HISTORY
setopt SHARE_HISTORY

autoload -Uz compinit
compinit

# --- 2. SYSTEM INFO & PROMPT ---
# Caelestia's current shell color sequence (optional outside Caelestia).
\cat "$HOME/.local/state/caelestia/sequences.txt" 2>/dev/null
clear
# fastfetch

eval "$(starship init zsh)"

# --- 3. TOOLS & INTEGRATIONS ---
eval "$(zoxide init zsh --cmd cd)"
source /usr/share/fzf/key-bindings.zsh 2>/dev/null
source /usr/share/fzf/completion.zsh 2>/dev/null

# --- 4. ALIASES & FUNCTIONS ---
alias ls='eza --icons --git'
alias ll='eza -la --icons --git'
alias cat='bat'
alias grep='rg'
alias lf='yazi'
alias c='clear'

# Project-specific shortcuts. These intentionally stay here as personal workflow
# helpers rather than pretending they are portable system configuration.
alias i='cd "$HOME/Programs/ice" && source .venv/bin/activate && clear'
alias z='zellij'
alias dup='cd docker && docker compose up -d && cd ..'
alias ddown='cd docker && docker compose down && cd ..'
alias crun='uv run celery -A src.workers.celery_app worker -B --loglevel=info'
alias srun='uv run uvicorn src.api.main:app --host 0.0.0.0 --port 8000 --reload'
alias e='exit'
alias t='tmux new-session -A -s main'
alias tn='tmux new-session'
nvim() {
    setsid -f ghostty \
        --window-padding-x=6 \
        --window-padding-y=6 \
        --background=#0e0e0e \
        --window-padding-color=background \
        -e nvim "$@" \
        </dev/null >/dev/null 2>&1
}
vllm-bg() {
    vllm serve Qwen/Qwen2.5-3B-Instruct-AWQ \
        --port 8002 \
        --max-model-len 8192 \
        --gpu-memory-utilization 0.25 \
        --enforce-eager \
        --kv-cache-dtype fp8
}

# Labeling server (NO fp8 – for strict JSON output)
vllm-label() {
    vllm serve Qwen/Qwen2.5-7B-Instruct-AWQ \
        --port 8001 \
        --max-model-len 20000 \
        --gpu-memory-utilization 0.95 \
        --enforce-eager
}

# Coder server (WITH fp8 – safe for free-form text)
vllm-coder() {
    vllm serve Qwen/Qwen2.5-Coder-14B-Instruct-AWQ \
        --port 8001 \
        --max-model-len 131072 \
        --gpu-memory-utilization 0.95 \
        --kv-cache-dtype fp8 \
        --enforce-eager
}

vllm-status() {
    echo "=== vLLM Health ==="
    echo "  Status: $(curl -s -o /dev/null -w '%{http_code}' http://localhost:8001/health)"
    echo ""
    echo "=== Model Loaded ==="
    curl -s http://localhost:8001/v1/models | jq '{id: .data[0].id, max_model_len: .data[0].max_model_len}'
    echo ""
    echo "=== GPU Usage ==="
    nvidia-smi --query-gpu=memory.used,memory.total --format=csv,noheader
}

function y() {
  local tmp="$(mktemp -t "yazi-cwd.XXXXX")"
  yazi "$@" --cwd-file="$tmp"
  if cwd="$(cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
    builtin cd -- "$cwd"
  fi
  rm -f -- "$tmp"
}

code() {
  command code "$@" > /dev/null 2>&1 &
}

# --- 5. ZSH PLUGINS ---
source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh 2>/dev/null
source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh 2>/dev/null
source /usr/share/zsh/plugins/zsh-history-substring-search/zsh-history-substring-search.zsh 2>/dev/null

# --- 6. ENVIRONMENT ---
# These files are optional so a fresh machine can start without every tool
# already installed.
[[ -f "$HOME/.local/share/../bin/env" ]] && . "$HOME/.local/share/../bin/env"
export PATH="$HOME/.local/bin:$PATH"
export PATH="/opt/cuda/bin:$PATH"
export LD_LIBRARY_PATH="/opt/cuda/lib64${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

eval "$(fnm env --use-on-cd)"

export SDKMAN_DIR="$HOME/.sdkman"
[[ -s "$SDKMAN_DIR/bin/sdkman-init.sh" ]] && source "$SDKMAN_DIR/bin/sdkman-init.sh"

# Qwen Code
export PATH="$HOME/.local/bin:$PATH"

# opencode
export PATH="$HOME/.opencode/bin:$PATH"
export LANG=en_IN.UTF-8
export LC_CTYPE=en_IN.UTF-8
